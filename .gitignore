# --- secrets -----------------------------------------------------------
# NOTE: `.env` and `API.txt` hold the LLM gateway key. Never commit either.
.env
.env.*
!.env.example
API.txt

# --- generated output --------------------------------------------------
# Analysis reports contain real names and real conversations. The original
# .gitignore read `web_report/*` (singular), which never matched the real
# directory `web_reports/`; eleven reports were committed as a result.
web_reports/
reports/
chat_sessions/*.json
!chat_sessions/.gitkeep

# --- python ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
